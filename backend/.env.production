# ──────────────────────────────────────────────────────────────────────────────
# MediVerse AI — Backend Production Environment
# Set EACH of these as Azure App Service → Configuration → Application Settings
# NEVER commit this file to git
# ──────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
ENV=production
DEBUG=False
APP_NAME=MediVerse AI
VERSION=1.0.0
ENABLE_DOCS=True

# ── Database (Supabase PostgreSQL — Transaction pooler) ───────────────────────
# Get from: Supabase Dashboard → Project Settings → Database → URI (Transaction mode)
DATABASE_URL=postgresql+asyncpg://postgres.XXXX:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── Auth / JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=hD7GzA1MwE-gB4XvQa_-wK2u4ayxE6ZTEDMNYiI7H25J1ILAJJWA93rpjnreVb9ilt6gh_KQomHePUn6vGIqbg
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["https://mediverse.alokkumarsahu.in","http://localhost:3000"]

# ── Gemini AI (primary inference engine) ─────────────────────────────────────
GEMINI_API_KEY=AIzaSyDTpmCy2y5CHwFjvOpiAoBLro_DArElvtI
GEMINI_MODEL_TEXT=gemini-2.0-flash
GEMINI_MODEL_VISION=gemini-2.0-flash
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_SEC=30
GEMINI_MAX_RETRIES=3
GEMINI_RPM=15

# ── File Uploads ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name  (optional)

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://mediverse.alokkumarsahu.in
API_URL=https://api.mediverse.alokkumarsahu.in

# ── Server tuning (Azure B1 = 1 vCPU) ────────────────────────────────────────
WORKERS=2
PORT=8000
HOST=0.0.0.0

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# ── Redis (optional — enables distributed rate limit + caching) ───────────────
REDIS_ENABLED=False
# REDIS_URL=rediss://mediverse.redis.cache.windows.net:6380?password=KEY&ssl=True
