# ──────────────────────────────────────────────────────────────────────────────
# MediVerse AI — Backend Production Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill BEFORE deploying.
# On Azure App Service: set as Application Settings (not committed to git).
# On Render: set in Environment → Add Environment Variable.
# ──────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
APP_NAME=MediVerse AI
APP_VERSION=1.0.0

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Get from: Supabase → Project Settings → Database → Connection string → URI
# Use "Transaction" pooler URL (port 6543) for production serverless workloads
DATABASE_URL=postgresql+asyncpg://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL_SYNC=postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
REFRESH_EXPIRE_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=https://mediverse.alokkumarsahu.in,https://staging.mediverse.alokkumarsahu.in

# ── ML model paths (relative to container /app) ───────────────────────────────
MODEL_BASE_PATH=/app/ml_models
DIABETES_MODEL_PATH=/app/ml_models/diabetes/diabetes_xgb.onnx
SKIN_MODEL_PATH=/app/ml_models/skin/skin_efficientnet.onnx
XRAY_MODEL_PATH=/app/ml_models/xray/xray_ensemble.onnx
ECG_MODEL_PATH=/app/ml_models/ecg/ecg_cnn_lstm.onnx

# ── Redis (optional — enables rate limit state + caching) ────────────────────
# Render Redis: get from Render dashboard
# REDIS_URL=redis://default:PASSWORD@REGION.render.com:6379
# Azure Redis: get from Azure Cache for Redis → Access keys
# REDIS_URL=rediss://mediverse.redis.cache.windows.net:6380?password=KEY&ssl=True

# ── Email / SMTP (optional — for verification + password reset) ───────────────
# Using SendGrid free tier (100 emails/day)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxx
# FROM_EMAIL=noreply@mediverse.alokkumarsahu.in
# FROM_NAME=MediVerse AI

# ── Cloudinary (optional — model result image storage) ────────────────────────
# CLOUDINARY_CLOUD_NAME=mediverse
# CLOUDINARY_API_KEY=XXXX
# CLOUDINARY_API_SECRET=XXXX

# ── Sentry (optional — backend error tracking) ────────────────────────────────
# SENTRY_DSN=https://xxxx@oXXX.ingest.sentry.io/XXXXXX

# ── Gunicorn / Uvicorn tuning ─────────────────────────────────────────────────
# Azure: workers = 2*CPU+1 (Basic B1 = 1 CPU → 3 workers)
WORKERS=3
HOST=0.0.0.0
PORT=8000
