# ============================================================
# MediVerse AI — Environment Variables Template
# Copy to .env and fill in real values. Never commit .env
# ============================================================

# App
APP_NAME=MediVerse AI
ENV=development

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/mediverse

# Auth
JWT_SECRET=change-me-32-bytes-random-string
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Redis (Upstash or Azure Cache)
REDIS_URL=redis://localhost:6379

# File Storage (Cloudinary)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# URLs
FRONTEND_URL=https://mediverse.alokkumarsahu.in
API_URL=https://api.mediverse.alokkumarsahu.in

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://mediverse.alokkumarsahu.in
