# ──────────────────────────────────────────────────────────────────────────────
# MediVerse AI — Frontend (Cloudflare Pages)
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local dev.
# Set these as Environment Variables in the Cloudflare Pages dashboard
# under Settings → Environment variables (set BOTH Production + Preview).
# ──────────────────────────────────────────────────────────────────────────────

# Backend API base URL (NO trailing slash)
NEXT_PUBLIC_API_URL=https://api.mediverse.alokkumarsahu.in

# Frontend canonical URL (used for OG tags, absolute links)
NEXT_PUBLIC_APP_URL=https://mediverse.alokkumarsahu.in

# App display name
NEXT_PUBLIC_APP_NAME=MediVerse AI

# Cloudflare Pages build flag (set automatically by CF Pages, but explicit is safer)
CF_PAGES=1

# ── Optional: Analytics ──────────────────────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Optional: Sentry (frontend error tracking) ────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXX.ingest.sentry.io/XXXXXX

# ── Optional: Cloudinary (image uploads from browser) ─────────────────────────
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=mediverse
