nt 1px);background-size:72px 72px;mask-image:radial-gradient(ellipse 80% 80% at 50% 0%, black 30%, transparent 100%)\"></div><div class=\"relative max-w-[1160px] mx-auto px-6 md:px-10 grid grid-cols-1 lg:grid-cols-[1fr_420px] gap-16 items-center\" style=\"padding-top:clamp(80px, 12vw, 140px);padding-bottom:clamp(80px, 10vw, 120px)\"><div style=\"opacity:1;transform:none\"><div class=\"inline-flex items-center gap-2 mb-8\" style=\"opacity:0;transform:translateY(20px)\"><span class=\"flex h-5 w-5 items-center justify-center rounded-full gradient-brand\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-activity h-2.5 w-2.5 text-white\"><path d=\"M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2\"></path></svg></span><span class=\"text-xs font-semibold tracking-widest uppercase text-muted-foreground\">Healthcare AI Platform</span></div><h1 class=\"font-bold tracking-tight\" style=\"font-size:clamp(2.4rem, 5.5vw, 4rem);line-height:1.1;opacity:0;transform:translateY(20px)\">Medical intelligence,<!-- --> <br class=\"hidden sm:block\"/><span class=\"font-serif italic font-normal text-gradient-hero\">finally accessible.</span></h1><p class=\"mt-7 text-[1.05rem] leading-relaxed text-muted-foreground max-w-[480px]\" style=\"opacity:0;transform:translateY(20px)\">Six clinical AI modules — chest X-ray, ECG, dermatology, metabolic risk, prescription parsing, symptom triage — in one secure platform. Results in under three seconds.</p><div class=\"mt-10 flex flex-wrap items-center gap-3\" style=\"opacity:0;transform:translateY(20px)\"><a id=\"hero-cta-primary\" class=\"group inline-flex items-center gap-2.5 px-6 py-3.5 rounded-xl font-semibold gradient-brand text-white shadow-brand text-[0.9rem] hover:opacity-90 transition-opacity\" href=\"/signup\">Start for free<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4 transition-transform group-hover:translate-x-0.5\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a id=\"hero-cta-secondary\" class=\"inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-semibold text-[0.9rem] text-foreground border border-border hover:bg-accent transition-colors\" href=\"/features\">Explore modules</a></div><p class=\"mt-8 text-xs text-muted-foreground/70\" style=\"opacity:0;transform:translateY(20px)\">No credit card · HIPAA-aligned · Models trained on peer-reviewed data</p></div><div class=\"hidden lg:block\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"animate-float relative\" style=\"perspective:1200px\"><div class=\"absolute inset-0 -z-10 blur-2xl opacity-30 rounded-3xl gradient-brand scale-90 translate-y-6\"></div><div class=\"rounded-2xl border border-border bg-card shadow-xl overflow-hidden\"><div class=\"flex items-center gap-2 px-4 py-3 border-b border-border bg-accent/30\"><div class=\"flex gap-1.5\"><span class=\"h-2.5 w-2.5 rounded-full bg-rose-400/80\"></span><span class=\"h-2.5 w-2.5 rounded-full bg-amber-400/80\"></span><span class=\"h-2.5 w-2.5 rounded-full bg-emerald-400/80\"></span></div><div class=\"flex-1 text-center\"><div class=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-background border border-border text-[11px] text-muted-foreground\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check h-3 w-3 text-primary\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg>mediverse.alokkumarsahu.in</div></div></div><div class=\"p-5\"><div class=\"flex items-center gap-2 mb-4\"><div class=\"h-7 w-7 rounded-lg gradient-brand flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-radiation h-3.5 w-3.5 text-white\"><path d=\"M12 12h.01\"></path><path d=\"M7.5 4.2c-.3-.5-.9-.7-1.3-.4C3.9 5.5 2.3 8.1 2 11c-.1.5.4 1 1 1h5c0-1.5.8-2.8 2-3.4-1.1-1.9-2-3.5-2.5-4.4z\"></path><path d=\"M21 12c.6 0 1-.4 1-1-.3-2.9-1.8-5.5-4.1-7.1-.4-.3-1.1-.2-1.3.3-.6.9-1.5 2.5-2.6 4.3 1.2.7 2 2 2 3.5h5z\"></path><path d=\"M7.5 19.8c-.3.5-.1 1.1.4 1.3 2.6 1.2 5.6 1.2 8.2 0 .5-.2.7-.8.4-1.3-.5-.9-1.4-2.5-2.5-4.3-1.2.7-2.8.7-4 0-1.1 1.8-2 3.4-2.5 4.3z\"></path></svg></div><div><p class=\"text-[11px] font-semibold\">Chest X-Ray Analysis</p><p class=\"text-[10px] text-muted-foreground\">Completed · 2.1s</p></div><span class=\"ml-auto chip bg-emerald-500/10 text-emerald-600 dark:text-emerald-400\">Normal</span></div><div class=\"space-y-2.5\"><div><div class=\"flex justify-between mb-1\"><span class=\"text-[10px] text-muted-foreground\">No Finding</span><span class=\"text-[10px] font-medium\">94<!-- -->%</span></div><div class=\"h-1.5 w-full rounded-full bg-muted overflow-hidden\"><div class=\"h-full rounded-full bg-emerald-500\" style=\"width:0px\"></div></div></div><div><div class=\"flex justify-between mb-1\"><span class=\"text-[10px] text-muted-foreground\">Atelectasis</span><span class=\"text-[10px] font-medium\">4<!-- -->%</span></div><div class=\"h-1.5 w-full rounded-full bg-muted overflow-hidden\"><div class=\"h-full rounded-full bg-amber-400\" style=\"width:0px\"></div></div></div><div><div class=\"flex justify-between mb-1\"><span class=\"text-[10px] text-muted-foreground\">Pneumonia</span><span class=\"text-[10px] font-medium\">2<!-- -->%</span></div><div class=\"h-1.5 w-full rounded-full bg-muted overflow-hidden\"><div class=\"h-full rounded-full bg-rose-400\" style=\"width:0px\"></div></div></div></div><div class=\"border-t border-border/60 my-4\"></div><div class=\"rounded-xl bg-primary/6 border border-primary/15 p-3\"><p class=\"text-[10px] font-semibold text-primary mb-1\">Clinical note</p><p class=\"text-[10px] text-muted-foreground leading-relaxed\">No radiological abnormality detected. Recommend annual follow-up. This is a screening aid — not a diagnosis.</p></div></div></div></div></div></div></section><section class=\"border-y border-border/60 surface-1\"><div class=\"max-w-[1160px] mx-auto px-6 md:px-10 py-7\"><div class=\"grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-0 md:divide-x divide-border/60\"><div class=\"flex items-center gap-3.5 px-0 md:px-8 first:pl-0 last:pr-0\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex h-9 w-9 items-center justify-center rounded-xl bg-primary/8 shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-activity h-4 w-4 text-primary\"><path d=\"M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2\"></path></svg></div><div><p class=\"text-xl font-bold tracking-tight text-foreground leading-none\">6</p><p class=\"text-[11px] text-muted-foreground mt-0.5 leading-none\">Diagnostic modules</p></div></div><div class=\"flex items-center gap-3.5 px-0 md:px-8 first:pl-0 last:pr-0\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex h-9 w-9 items-center justify-center rounded-xl bg-primary/8 shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clock h-4 w-4 text-primary\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><polyline points=\"12 6 12 12 16 14\"></polyline></svg></div><div><p class=\"text-xl font-bold tracking-tight text-foreground leading-none\">&lt;3s</p><p class=\"text-[11px] text-muted-foreground mt-0.5 leading-none\">Median analysis time</p></div></div><div class=\"flex items-center gap-3.5 px-0 md:px-8 first:pl-0 last:pr-0\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex h-9 w-9 items-center justify-center rounded-xl bg-primary/8 shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check h-4 w-4 text-primary\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></div><div><p class=\"text-xl font-bold tracking-tight text-foreground leading-none\">HIPAA</p><p class=\"text-[11px] text-muted-foreground mt-0.5 leading-none\">Security compliant</p></div></div><div class=\"flex items-center gap-3.5 px-0 md:px-8 first:pl-0 last:pr-0\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex h-9 w-9 items-center justify-center rounded-xl bg-primary/8 shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-trending-up h-4 w-4 text-primary\"><polyline points=\"22 7 13.5 15.5 8.5 10.5 2 17\"></polyline><polyline points=\"16 7 22 7 22 13\"></polyline></svg></div><div><p class=\"text-xl font-bold tracking-tight text-foreground leading-none\">99.9%</p><p class=\"text-[11px] text-muted-foreground mt-0.5 leading-none\">Platform uptime</p></div></div></div></div></section><section id=\"modules\" class=\"py-28 px-6 md:px-10 max-w-[1160px] mx-auto w-full\"><div class=\"mb-16 max-w-lg\"><p class=\"text-xs font-semibold tracking-widest uppercase text-primary mb-3\">Diagnostic modules</p><h2 class=\"font-bold mb-4\" style=\"letter-spacing:-0.025em\">Six AI screens,<br/><span class=\"text-muted-foreground font-normal\">one platform.</span></h2><p class=\"text-muted-foreground leading-relaxed\">Each module is an independent, production-grade inference engine — not a demo. Trained on real clinical datasets, validated against published benchmarks.</p></div><div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\"><div style=\"opacity:0;transform:translateY(20px)\"><a id=\"module-xray\" class=\"group block h-full p-6 rounded-2xl border bg-card transition-shadow duration-200 hover:shadow-md bg-sky-500/8 border-sky-200/60 dark:border-sky-800/40\" href=\"/xray\"><div class=\"inline-flex p-2.5 rounded-xl mb-5\" style=\"background-color:hsl(196, 88%, 42%)12\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-radiation h-5 w-5\" style=\"color:hsl(196, 88%, 42%)\"><path d=\"M12 12h.01\"></path><path d=\"M7.5 4.2c-.3-.5-.9-.7-1.3-.4C3.9 5.5 2.3 8.1 2 11c-.1.5.4 1 1 1h5c0-1.5.8-2.8 2-3.4-1.1-1.9-2-3.5-2.5-4.4z\"></path><path d=\"M21 12c.6 0 1-.4 1-1-.3-2.9-1.8-5.5-4.1-7.1-.4-.3-1.1-.2-1.3.3-.6.9-1.5 2.5-2.6 4.3 1.2.7 2 2 2 3.5h5z\"></path><path d=\"M7.5 19.8c-.3.5-.1 1.1.4 1.3 2.6 1.2 5.6 1.2 8.2 0 .5-.2.7-.8.4-1.3-.5-.9-1.4-2.5-2.5-4.3-1.2.7-2.8.7-4 0-1.1 1.8-2 3.4-2.5 4.3z\"></path></svg></div><p class=\"text-[10px] font-semibold tracking-widest uppercase mb-1\" style=\"color:hsl(196, 88%, 42%)\">17 diseases detected</p><h3 class=\"font-semibold text-[1.05rem] mb-2 text-foreground\">Chest X-Ray</h3><p class=\"text-[0.8rem] text-muted-foreground leading-relaxed\">EfficientNet-B4 ensemble trained on NIH ChestX-ray14 dataset.</p><div class=\"mt-5 flex items-center gap-1 text-[0.78rem] font-medium opacity-0 group-hover:opacity-100 transition-opacity\" style=\"color:hsl(196, 88%, 42%)\">Open module <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-3.5 w-3.5\"><path d=\"m9 18 6-6-6-6\"></path></svg></div></a></div><div style=\"opacity:0;transform:translateY(20px)\"><a id=\"module-ecg\" class=\"group block h-full p-6 rounded-2xl border bg-card transition-shadow duration-200 hover:shadow-md bg-rose-500/8 border-rose-200/60 dark:border-rose-800/40\" href=\"/ecg\"><div class=\"inline-flex p-2.5 rounded-xl mb-5\" style=\"background-color:hsl(350, 82%, 58%)12\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-heart h-5 w-5\" style=\"color:hsl(350, 82%, 58%)\"><path d=\"M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z\"></path></svg></div><p class=\"text-[10px] font-semibold tracking-widest uppercase mb-1\" style=\"color:hsl(350, 82%, 58%)\">Real-time rhythm</p><h3 class=\"font-semibold text-[1.05rem] mb-2 text-foreground\">ECG Analysis</h3><p class=\"text-[0.8rem] text-muted-foreground leading-relaxed\">CNN-LSTM pipeline on MIT-BIH Arrhythmia Database signals.</p><div class=\"mt-5 flex items-center gap-1 text-[0.78rem] font-medium opacity-0 group-hover:opacity-100 transition-opacity\" style=\"color:hsl(350, 82%, 58%)\">Open module <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-3.5 w-3.5\"><path d=\"m9 18 6-6-6-6\"></path></svg></div></a></div><div style=\"opacity:0;transform:translateY(20px)\"><a id=\"module-skin\" class=\"group block h-full p-6 rounded-2xl border bg-card transition-shadow duration-200 hover:shadow-md bg-orange-500/8 border-orange-200/60 dark:border-orange-800/40\" href=\"/skin\"><div class=\"inline-flex p-2.5 rounded-xl mb-5\" style=\"background-color:hsl(28, 88%, 56%)12\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-scan h-5 w-5\" style=\"color:hsl(28, 88%, 56%)\"><path d=\"M3 7V5a2 2 0 0 1 2-2h2\"></path><path d=\"M17 3h2a2 2 0 0 1 2 2v2\"></path><path d=\"M21 17v2a2 2 0 0 1-2 2h-2\"></path><path d=\"M7 21H5a2 2 0 0 1-2-2v-2\"></path></svg></div><p class=\"text-[10px] font-semibold tracking-widest uppercase mb-1\" style=\"color:hsl(28, 88%, 56%)\">7 lesion classes</p><h3 class=\"font-semibold text-[1.05rem] mb-2 text-foreground\">Skin Lesion</h3><p class=\"text-[0.8rem] text-muted-foreground leading-relaxed\">EfficientNet-B3 on HAM10000 with Grad-CAM saliency maps.</p><div class=\"mt-5 flex items-center gap-1 text-[0.78rem] font-medium opacity-0 group-hover:opacity-100 transition-opacity\" style=\"color:hsl(28, 88%, 56%)\">Open module <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-3.5 w-3.5\"><path d=\"m9 18 6-6-6-6\"></path></svg></div></a></div><div style=\"opacity:0;transform:translateY(20px)\"><a id=\"module-diabetes\" class=\"group block h-full p-6 rounded-2xl border bg-card transition-shadow duration-200 hover:shadow-md bg-violet-500/8 border-violet-200/60 dark:border-violet-800/40\" href=\"/diabetes\"><div class=\"inline-flex p-2.5 rounded-xl mb-5\" style=\"background-color:hsl(262, 72%, 60%)12\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-flask-conical h-5 w-5\" style=\"color:hsl(262, 72%, 60%)\"><path d=\"M10 2v7.527a2 2 0 0 1-.211.896L4.72 20.55a1 1 0 0 0 .9 1.45h12.76a1 1 0 0 0 .9-1.45l-5.069-10.127A2 2 0 0 1 14 9.527V2\"></path><path d=\"M8.5 2h7\"></path><path d=\"M7 16h10\"></path></svg></div><p class=\"text-[10px] font-semibold tracking-widest uppercase mb-1\" style=\"color:hsl(262, 72%, 60%)\">SHAP explainability</p><h3 class=\"font-semibold text-[1.05rem] mb-2 text-foreground\">Diabetes Risk</h3><p class=\"text-[0.8rem] text-muted-foreground leading-relaxed\">Calibrated XGBoost with 6 clinical biomarkers. PIMA dataset.</p><div class=\"mt-5 flex items-center gap-1 text-[0.78rem] font-medium opacity-0 group-hover:opacity-100 transition-opacity\" style=\"color:hsl(262, 72%, 60%)\">Open module <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-3.5 w-3.5\"><path d=\"m9 18 6-6-6-6\"></path></svg></div></a></div><div style=\"opacity:0;transform:translateY(20px)\"><a id=\"module-prescription\" class=\"group block h-full p-6 rounded-2xl border bg-card transition-shadow duration-200 hover:shadow-md bg-emerald-500/8 border-emerald-200/60 dark:border-emerald-800/40\" href=\"/prescription\"><div class=\"inline-flex p-2.5 rounded-xl mb-5\" style=\"background-color:hsl(158, 50%, 44%)12\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-text h-5 w-5\" style=\"color:hsl(158, 50%, 44%)\"><path d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"></path><path d=\"M14 2v4a2 2 0 0 0 2 2h4\"></path><path d=\"M10 9H8\"></path><path d=\"M16 13H8\"></path><path d=\"M16 17H8\"></path></svg></div><p class=\"text-[10px] font-semibold tracking-widest uppercase mb-1\" style=\"color:hsl(158, 50%, 44%)\">Structured extraction</p><h3 class=\"font-semibold text-[1.05rem] mb-2 text-foreground\">Prescription OCR</h3><p class=\"text-[0.8rem] text-muted-foreground leading-relaxed\">Vision + NLP pipeline — medicines, doses, warnings in seconds.</p><div class=\"mt-5 flex items-center gap-1 text-[0.78rem] font-medium opacity-0 group-hover:opacity-100 transition-opacity\" style=\"color:hsl(158, 50%, 44%)\">Open module <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-3.5 w-3.5\"><path d=\"m9 18 6-6-6-6\"></path></svg></div></a></div><div style=\"opacity:0;transform:translateY(20px)\"><a id=\"module-symptoms\" class=\"group block h-full p-6 rounded-2xl border bg-card transition-shadow duration-200 hover:shadow-md bg-amber-500/8 border-amber-200/60 dark:border-amber-800/40\" href=\"/symptoms\"><div class=\"inline-flex p-2.5 rounded-xl mb-5\" style=\"background-color:hsl(38, 88%, 54%)12\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-message-square h-5 w-5\" style=\"color:hsl(38, 88%, 54%)\"><path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"></path></svg></div><p class=\"text-[10px] font-semibold tracking-widest uppercase mb-1\" style=\"color:hsl(38, 88%, 54%)\">NLP triage engine</p><h3 class=\"font-semibold text-[1.05rem] mb-2 text-foreground\">Symptom Checker</h3><p class=\"text-[0.8rem] text-muted-foreground leading-relaxed\">Differential diagnosis &amp; specialist routing in natural language.</p><div class=\"mt-5 flex items-center gap-1 text-[0.78rem] font-medium opacity-0 group-hover:opacity-100 transition-opacity\" style=\"color:hsl(38, 88%, 54%)\">Open module <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-3.5 w-3.5\"><path d=\"m9 18 6-6-6-6\"></path></svg></div></a></div></div></section><section class=\"py-28 border-t border-border/60 surface-1\"><div class=\"max-w-[1160px] mx-auto px-6 md:px-10\"><div class=\"grid grid-cols-1 lg:grid-cols-[360px_1fr] gap-16 items-start\"><div class=\"lg:sticky lg:top-24\"><p class=\"text-xs font-semibold tracking-widest uppercase text-primary mb-3\">Why it matters</p><h2 class=\"font-bold mb-4\">Built for real clinical use cases.</h2><p class=\"text-muted-foreground leading-relaxed text-[0.95rem]\">We obsess over two things: accuracy and trust. Every decision in the product — from model choice to UI copy — exists to serve clinicians and patients honestly.</p><a id=\"why-learn-more\" class=\"inline-flex items-center gap-1.5 mt-6 text-sm font-medium text-primary hover:underline underline-offset-4\" href=\"/about\">Our methodology <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right h-3.5 w-3.5\"><path d=\"m9 18 6-6-6-6\"></path></svg></a></div><div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\"><div class=\"p-6 rounded-2xl border border-border/60 bg-card shadow-xs\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-primary/8 mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-zap h-5 w-5 text-primary\"><path d=\"M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z\"></path></svg></div><h4 class=\"font-semibold text-[0.95rem] mb-2\">Instant inference</h4><p class=\"text-[0.82rem] text-muted-foreground leading-relaxed\">Quantised ONNX models return clinical-grade results in under 3 seconds on modest hardware.</p></div><div class=\"p-6 rounded-2xl border border-border/60 bg-card shadow-xs\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-primary/8 mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-lock h-5 w-5 text-primary\"><rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg></div><h4 class=\"font-semibold text-[0.95rem] mb-2\">Privacy by design</h4><p class=\"text-[0.82rem] text-muted-foreground leading-relaxed\">Your images and records never leave your session. Zero telemetry. End-to-end HTTPS.</p></div><div class=\"p-6 rounded-2xl border border-border/60 bg-card shadow-xs\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-primary/8 mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star h-5 w-5 text-primary\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg></div><h4 class=\"font-semibold text-[0.95rem] mb-2\">Research-grade models</h4><p class=\"text-[0.82rem] text-muted-foreground leading-relaxed\">Every model trained on publicly peer-reviewed clinical datasets. Confidence scores included.</p></div><div class=\"p-6 rounded-2xl border border-border/60 bg-card shadow-xs\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-primary/8 mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-5 w-5 text-primary\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg></div><h4 class=\"font-semibold text-[0.95rem] mb-2\">Specialist-ready reports</h4><p class=\"text-[0.82rem] text-muted-foreground leading-relaxed\">Structured PDF exports doctors actually read. Not walls of raw probability outputs.</p></div></div></div></div></section><section class=\"py-28 px-6 md:px-10\"><div class=\"max-w-[1160px] mx-auto\"><div class=\"relative overflow-hidden rounded-3xl gradient-brand p-px\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"relative rounded-[23px] overflow-hidden bg-gradient-to-br from-[hsl(196,88%,40%)] to-[hsl(196,95%,28%)] px-8 md:px-16 py-16 md:py-20 text-white\"><div class=\"pointer-events-none absolute inset-0 opacity-10\" style=\"background-image:radial-gradient(circle at 80% 20%, white 0%, transparent 50%)\"></div><div class=\"relative max-w-xl\"><p class=\"text-xs font-semibold tracking-widest uppercase opacity-70 mb-4\">Start today</p><h2 class=\"font-bold text-white mb-5\" style=\"letter-spacing:-0.025em\">Your first analysis is free.</h2><p class=\"text-white/75 text-[0.95rem] leading-relaxed mb-8\">No sign-up friction, no credit card, no waitlist. Upload a scan and get a structured AI report in seconds.</p><div class=\"flex flex-wrap gap-3\"><a id=\"bottom-cta-btn\" class=\"inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-semibold bg-white text-[hsl(196,88%,34%)] text-[0.9rem] hover:bg-white/95 transition-colors shadow-xl\" href=\"/signup\">Create free account <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right h-4 w-4\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a id=\"bottom-cta-signin\" class=\"inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-semibold text-white/90 border border-white/25 hover:bg-white/10 transition-colors text-[0.9rem]\" href=\"/login\">Sign in</a></div></div></div></div></div></section><footer id=\"site-footer\" class=\"border-t border-border/60 surface-1 mt-auto\"><div class=\"max-w-[1160px] mx-auto px-6 md:px-10 py-14\"><div class=\"grid grid-cols-2 md:grid-cols-[200px_1fr_1fr_1fr] gap-10 mb-12\"><div class=\"col-span-2 md:col-span-1\"><a class=\"inline-flex items-center gap-2.5 mb-4 group\" href=\"/\"><span class=\"flex h-7 w-7 items-center justify-center rounded-[8px] gradient-brand shadow-brand/30 shadow-sm\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-activity h-3.5 w-3.5 text-white\"><path d=\"M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2\"></path></svg></span><span class=\"font-bold text-[0.9rem] tracking-tight\">Medi<span class=\"text-gradient\">Verse</span></span></a><p class=\"text-[0.8rem] text-muted-foreground leading-relaxed max-w-[180px]\">Clinical AI screening that respects your privacy and your time.</p><div class=\"flex gap-2 mt-5\"><a href=\"https://github.com/alokkumar2510\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"GitHub\" class=\"p-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-accent transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-github h-3.5 w-3.5\"><path d=\"M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4\"></path><path d=\"M9 18c-4.51 2-5-2-7-2\"></path></svg></a><a href=\"https://twitter.com/alok_chintu\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Twitter\" class=\"p-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-accent transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-twitter h-3.5 w-3.5\"><path d=\"M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z\"></path></svg></a><a href=\"https://linkedin.com/\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"LinkedIn\" class=\"p-2 rounded-lg text-muted-foreground hover:text-foreground hover:bg-accent transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"n