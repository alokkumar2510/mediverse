dark)\" content=\"#0b1221\"/><title>Terms &amp; Conditions — MediVerse AI | MediVerse AI</title><meta name=\"description\" content=\"Read the Terms and Conditions governing your use of the MediVerse AI clinical screening platform.\"/><link rel=\"author\" href=\"https://mediverse.alokkumarsahu.in\"/><meta name=\"author\" content=\"MediVerse AI\"/><meta name=\"keywords\" content=\"AI healthcare,medical screening,X-ray analysis,ECG analysis,diabetes prediction,skin disease AI,prescription OCR,symptom checker,MediVerse\"/><meta name=\"creator\" content=\"Alok Kumar Sahu\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow\"/><meta property=\"og:title\" content=\"MediVerse AI — AI-Powered Healthcare Screening\"/><meta property=\"og:description\" content=\"Instant AI-powered medical screening: X-ray, ECG, skin, diabetes, prescription OCR &amp; symptom checker.\"/><meta property=\"og:url\" content=\"https://mediverse.alokkumarsahu.in\"/><meta property=\"og:site_name\" content=\"MediVerse AI\"/><meta property=\"og:locale\" content=\"en_US\"/><meta property=\"og:image\" content=\"https://mediverse.alokkumarsahu.in/og-image.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"MediVerse AI\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"MediVerse AI\"/><meta name=\"twitter:description\" content=\"AI-powered healthcare screening platform.\"/><meta name=\"twitter:image\" content=\"https://mediverse.alokkumarsahu.in/og-image.png\"/><link rel=\"shortcut icon\" href=\"/favicon-16x16.png\"/><link rel=\"icon\" href=\"/favicon.ico\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"antialiased min-h-screen\" style=\