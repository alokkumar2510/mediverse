 href=\"https://mediverse.alokkumarsahu.in\"/><meta name=\"author\" content=\"MediVerse AI\"/><meta name=\"keywords\" content=\"AI healthcare,medical screening,X-ray analysis,ECG analysis,diabetes prediction,skin disease AI,prescription OCR,symptom checker,MediVerse\"/><meta name=\"creator\" content=\"Alok Kumar Sahu\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow\"/><meta property=\"og:title\" content=\"MediVerse AI — AI-Powered Healthcare Screening\"/><meta property=\"og:description\" content=\"Instant AI-powered medical screening: X-ray, ECG, skin, diabetes, prescription OCR &amp; symptom checker.\"/><meta property=\"og:url\" content=\"https://mediverse.alokkumarsahu.in\"/><meta property=\"og:site_name\" content=\"MediVerse AI\"/><meta property=\"og:locale\" content=\"en_US\"/><meta property=\"og:image\" content=\"https://mediverse.alokkumarsahu.in/og-image.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"MediVerse AI\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"MediVerse AI\"/><meta name=\"twitter:description\" content=\"AI-powered healthcare screening platform.\"/><meta name=\"twitter:image\" content=\"https://mediverse.alokkumarsahu.in/og-image.png\"/><link rel=\"shortcut icon\" href=\"/favicon-16x16.png\"/><link rel=\"icon\" href=\"/favicon.ico\"/><link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"antialiased min-h-screen\" style=\"font-family:var(--font-inter), Inter, system-ui, -apple-system, sans-serif;background-color:hsl(var(--background));color:hsl(var(--foreground))\"><script>((e,t,r,n,o,l,a,i)=>{let u=document.documentElement,s=[\"light\",\"dark\"];function c(t){(Array.isArray(e)?e:[e]).forEach(e=>{let r=\"class\"===e,n=r&&l?o.map(e=>l[e]||e):o;r?(u.classList.remove(...n),u.classList.add(l&&l[t]?l[t]:t)):u.setAttribute(e,t)}),i&&s.includes(t)&&(u.style.colorScheme=t)}if(n)c(n);else try{let e=localStorage.getItem(t)||r,n=a&&\"system\"===e?window.matchMedia(\"(prefers-color-scheme: dark)\").matches?\"dark\":\"light\":e;c(n)}catch(e){}})(\"class\",\"theme\",\"dark\",null,[\"light\",\"dark\"],null,true,true)</script><div class=\"max-w-5xl mx-auto space-y-8 animate-in fade-in duration-500 pb-12\"><div class=\"flex flex-col md:flex-row md:items-center justify-between gap-4\"><div><a class=\"inline-flex items-center gap-2 text-sm text-slate-400 hover:text-white transition-colors mb-4\" href=\"/dashboard\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-left w-4 h-4\"><path d=\"m12 19-7-7 7-7\"></path><path d=\"M19 12H5\"></path></svg>Back to Dashboard</a><div class=\"flex items-center gap-3\"><div class=\"p-3 bg-blue-500/10 rounded-xl border border-blue-500/20\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-activity w-8 h-8 text-blue-500\"><path d=\"M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2\"></path></svg></div><div><h1 class=\"text-3xl font-bold text-white tracking-tight\">ECG AI Analysis</h1><p class=\"text-slate-400 mt-1\">Upload a 10-second ECG signal array to screen for arrhythmias.</p></div></div></div></div><div class=\"grid grid-cols-1 lg:grid-cols-3 gap-8\"><div class=\"lg:col-span-2\"><div class=\"space-y-6\"><div class=\"bg-slate-900 border border-slate-800 rounded-xl p-6 shadow-xl\"><h2 class=\"text-xl font-semibold text-white mb-4\">Upload ECG Signal</h2><p class=\"text-slate-400 text-sm mb-6\">Upload a 1D ECG signal file (.csv or .npy) containing recorded lead data. Ensure the data is properly formatted (1 value per row for CSV).</p><div class=\"border-2 border-dashed border-slate-700 rounded-lg p-8 flex flex-col items-center justify-center bg-slate-900/50 hover:bg-slate-800/50 transition-colors cursor-pointer group relative\"><input type=\"file\" accept=\".csv,.npy\" class=\"absolute inset-0 w-full h-full opacity-0 cursor-pointer\"/><div class=\"flex flex-col items-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cloud-upload w-12 h-12 text-slate-500 mb-3 group-hover:text-blue-500 transition-colors\"><path d=\"M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242\"></path><path d=\"M12 12v9\"></path><path d=\"m16 16-4-4-4 4\"></path></svg><p class=\"text-white font-medium\">Click or drag file to upload</p><p class=\"text-slate-500 text-xs mt-1\">Supported formats: .csv, .npy</p></div></div><div class=\"mt-6 flex justify-end\"><button disabled=\"\" class=\"px-6 py-2 bg-blue-600 hover:bg-blue-700 disabled:bg-slate-800 disabled:text-slate-500 text-white rounded-lg font-medium transition-colors flex items-center gap-2\">Analyze Signal</button></div></div><div class=\"bg-slate-900 border border-slate-800 rounded-xl p-6\"><h3 class=\"text-white font-medium mb-3 flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-activity w-4 h-4 text-blue-400\"><path d=\"M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2\"></path></svg>How it works</h3><ol class=\"list-decimal list-inside space-y-3 text-slate-400 text-sm\"><li><strong>Upload your data:</strong> Provide a <code>.csv</code> or <code>.npy</code> file containing 1D ECG signal data.</li><li><strong>Signal Processing:</strong> The AI applies a bandpass filter (0.5-40Hz) to remove baseline wander and noise.</li><li><strong>ResNet1D Inference:</strong> A PyTorch 1D Convolutional model runs inference locally or via backend.</li><li><strong>Clinical Assessment:</strong> Get a multi-class rhythm prediction (e.g. Normal, MI, Arrhythmia) with confidence scores.</li></ol></div></div></div><div class=\"space-y-6\"><div class=\"bg-slate-900 border border-slate-800 rounded-xl p-6 shadow-xl\"><h3 class=\"text-white font-medium mb-4 flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-alert w-5 h-5 text-indigo-500\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"M12 8v4\"></path><path d=\"M12 16h.01\"></path></svg>Dataset &amp; Model</h3><div class=\"space-y-4 text-sm text-slate-400\"><div><strong class=\"text-slate-300 block mb-1\">Training Data</strong><p>Trained on PTB-XL (21,837 clinical 12-lead ECGs) combined with mapping strategies for Arrhythmia and Conduction disturbances.</p></div><div><strong class=\"text-slate-300 block mb-1\">Architecture</strong><p>ResNet1D-34 optimized via ONNX Runtime. Mixed-precision trained on RTX 4050 6GB.</p></div><div><strong class=\"text-slate-300 block mb-1\">Limitations</strong><p>Designed for Lead I or Lead II rhythm screening. Not to be used as a definitive clinical diagnosis device.</p></div></div></div><div class=\"bg-gradient-to-br from-blue-900/40 to-indigo-900/40 border border-blue-500/20 rounded-xl p-6\"><h3 class=\"text-blue-400 font-medium mb-2\">Premium Module</h3><p class=\"text-slate-300 text-sm mb-4\">This module represents production-grade machine learning applied to physiological time-series data.</p><div class=\"h-1 w-full bg-blue-500/20 rounded-full overflow-hidden\"><div class=\"h-full bg-blue-500 w-full\"></div></div></div></div></div></div><div role=\"region\" aria-label=\"Notifications (F8)\" tabindex=\"-1\" style=\"pointer-events:none\"><ol tabindex=\"-1\" class=\"fixed top-4 right-4 z-[100] flex max-h-screen w-full flex-col-reverse gap-2 p-4 sm:max-w-[390px]\"></ol></div><script src=\"/_next/static/chunks/webpack-aa44a63be2da1f40.js\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0]);self.__next_f.push([2,null])</script><script>self.__next_f.push([1,\"1:HL[\\\"/_next/static/css/52d14c525d9518af.css\\\",\\\"style\\\"]\\n2:HL[\\\"/_next/static/css/0133390772ac3a63.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"3:I[2846,[],\\\"\\\"]\\n5:I[9107,[],\\\"ClientPageRoot\\\"]\\n6:I[5749,[\\\"2809\\\",\\\"static/chunks/2809-99e3ad713fbedc19.js\\\",\\\"2972\\\",\\\"static/chunks/2972-f981de8bfa048984.js\\\",\\\"674\\\",\\\"static/chunks/app/dashboard/ecg/page-14b3adb6349ced48.js\\\"],\\\"default\\\",1]\\n7:I[4707,[],\\\"\\\"]\\n8:I[6423,[],\\\"\\\"]\\n9:I[3396,[\\\"6137\\\",\\\"static/chunks/6137-de267f975f27b52e.js\\\",\\\"5658\\\",\\\"static/chunks/5658-a4265e91ed0236ba.js\\\",\\\"3185\\\",\\\"static/chunks/app/layout-944321554d4beb03.js\\\"],\\\"ThemeProvider\\\"]\\na:I[2972,[\\\"2972\\\",\\\"static/chunks/2972-f981de8bfa048984.js\\\",\\\"9160\\\",\\\"static/chunks/app/not-found-fc22e633c883fb86.js\\\"],\\\"\\\"]\\nb:I[9556,[\\\"6137\\\",\\\"static/chunks/6137-de267f975f27b52e.js\\\",\\\"5658\\\",\\\"static/chunks/5658-a4265e91ed0236ba.js\\\",\\\"3185\\\",\\\"static/chunks/app/layout-944321554d4beb03.js\\\"],\\\"Toaster\\\"]\\nd:I[1060,[],\\\"\\\"]\\ne:[]\\n\"])</script><scri